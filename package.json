{
  "name": "scorecheck",
  "version": "1.0.0",
  "description": "NBA 2K25 box score analysis application",
  "main": "dist/server/index.js",
  "scripts": {
    "dev": "concurrently --names \"api,client\" --prefix-colors \"blue,green\" \"npm run dev:api\" \"npm run dev:client\"",
    "dev:api": "cross-env NODE_ENV=development nodemon --exec ts-node -r tsconfig-paths/register src/server/index.ts",
    "dev:client": "cd client && npm run dev",
    "build": "npm run build:api && npm run build:client",
    "build:api": "tsc -p tsconfig.json && npx tsc-alias",
    "build:client": "cd client && npm run build",
    "start": "npx prisma migrate deploy && node dist/server/index.js",
    "assign-owner": "ts-node -r tsconfig-paths/register scripts/assign-data-owner.ts",
    "import:labeled": "ts-node -r tsconfig-paths/register scripts/import-labeled-data.ts",
    "backfill:screenshots": "ts-node -r tsconfig-paths/register scripts/backfill-screenshots.ts",
    "db:migrate": "npx prisma migrate deploy",
    "db:generate": "npx prisma generate",
    "db:studio": "npx prisma studio",
    "db:setup-admin": "node scripts/add-admin-role.js",
    "seed:mappings": "ts-node -r tsconfig-paths/register prisma/seed-mappings.ts",
    "eval": "ts-node -r tsconfig-paths/register --project eval/tsconfig.json eval/run_eval.ts",
    "eval:bench": "ts-node -r tsconfig-paths/register --project eval/tsconfig.json eval/run_eval.ts --pipeline=bench",
    "eval:junk": "ts-node -r tsconfig-paths/register --project eval/tsconfig.json eval/run_junk_filter_eval.ts",
    "label": "python scripts/label_gui.py",
    "label:cli": "ts-node -r tsconfig-paths/register scripts/add_training_example.ts",
    "edit": "python scripts/label_gui.py --no-scan",
    "extract": "ts-node -r tsconfig-paths/register scripts/extract_only.ts",
    "warmup": "ts-node -r tsconfig-paths/register scripts/warmup_model.ts",
    "export:dataset": "python scripts/export_dataset.py",
    "finetune": "python scripts/finetune.py",
    "finetune:export": "python scripts/export_dataset.py && python scripts/finetune.py",
    "test": "jest",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix"
  },
  "keywords": [
    "nba",
    "2k25",
    "basketball",
    "analytics",
    "box-score"
  ],
  "author": "ScoreCheck Team",
  "license": "MIT",
  "dependencies": {
    "@prisma/client": "^5.6.0",
    "@supabase/supabase-js": "^2.54.0",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "file-type": "^16.5.4",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.16.3",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "prisma": "^5.6.0",
    "sharp": "^0.34.3",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.8",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.9.0",
    "@types/pg": "^8.15.5",
    "@types/supertest": "^7.2.0",
    "@typescript-eslint/eslint-plugin": "^6.10.0",
    "@typescript-eslint/parser": "^6.10.0",
    "concurrently": "^8.2.2",
    "cross-env": "^10.1.0",
    "eslint": "^8.53.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.1",
    "supertest": "^7.2.2",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.1",
    "tsc-alias": "^1.8.10",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.2.2"
  }
}
