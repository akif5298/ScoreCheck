# ============================================================
# ScoreCheck — environment variable template
#
# 1. Copy this file to .env:   cp env.example .env
# 2. Fill in every value below with your own credentials.
# 3. NEVER commit .env to version control.
#    It is already listed in .gitignore, but double-check
#    before running "git add ." or a bulk staging command.
# ============================================================

# ── Database ─────────────────────────────────────────────────
# Supabase → Settings → Database → Connection string (URI)
DATABASE_URL="postgresql://username:password@host:5432/postgres"

# Direct/session connection (no transaction pooling) — used by prisma migrate.
# Can be the same as DATABASE_URL when it points at the session pooler (port 5432).
DIRECT_DATABASE_URL="postgresql://username:password@host:5432/postgres"

# ── Supabase ─────────────────────────────────────────────────
# Supabase → Settings → API → Project URL
SUPABASE_URL="https://your-project-ref.supabase.co"

# Supabase → Settings → API → Project API keys → anon / public
SUPABASE_PUBLISHABLE_KEY="your-anon-key-here"

# Supabase → Settings → API → Project API keys → service_role (keep secret!)
SUPABASE_SECRET_KEY="your-service-role-key-here"

# ── Auth ──────────────────────────────────────────────────────
# Required for signups. Anyone with this code can create an account;
# leave unset to disable signups entirely.
INVITE_CODE="pick-an-invite-code"

# ── JWT ───────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('base64'))"
JWT_SECRET="your-super-secret-jwt-key-minimum-32-characters"
JWT_EXPIRES_IN="7d"

# ── Server ────────────────────────────────────────────────────
PORT=3001
NODE_ENV="development"
# Comma-separated allowed origins in production (same-origin needs none).
# CORS_ORIGIN="https://your-app.onrender.com"
# pino log level: trace|debug|info|warn|error (default info)
# LOG_LEVEL="info"
# Max Postgres pool connections (default 10)
# PG_POOL_MAX=10

# ── File upload ───────────────────────────────────────────────
MAX_FILE_SIZE=10485760
UPLOAD_PATH="./uploads"

# ── Rate limiting & quotas ────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
# Per-user screenshots processed per day (default 50)
EXTRACTION_DAILY_LIMIT=50

# ── Ollama (stat extraction + junk filter) ────────────────────
# Local dev: install https://ollama.com then:
#   ollama pull minicpm-v:latest            (junk filter)
#   provision the fine-tuned Qwen2.5-VL     (stat extraction)
# Uploads return 503 if the host is unreachable; the junk filter fails open.
OLLAMA_BASE_URL=http://localhost:11434
# Extraction model tag (default scorecheck-ocr-r5:latest)
# OLLAMA_EXTRACTION_MODEL=scorecheck-ocr-r5:latest
# Bearer token for a secured/hosted extraction endpoint (unset for local Ollama)
# OLLAMA_API_KEY="your-hosted-endpoint-key"
# Per-call extraction timeout in ms (default 120000)
# EXTRACTION_TIMEOUT_MS=120000
